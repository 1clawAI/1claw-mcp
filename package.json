{
    "name": "@1claw/mcp",
    "version": "0.20.2",
    "description": "MCP server for the 1claw secrets vault — lets AI agents fetch, store, and manage secrets at runtime",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./security": {
            "types": "./dist/security/index.d.ts",
            "default": "./dist/security/index.js"
        }
    },
    "bin": {
        "1claw-mcp": "dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build",
        "dev": "npx fastmcp dev src/index.ts",
        "inspect": "npx fastmcp inspect src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "1claw",
        "mcp",
        "model-context-protocol",
        "secrets",
        "vault",
        "ai-agents",
        "hsm",
        "claude",
        "cursor",
        "fastmcp",
        "agent-tools"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/1clawAI/1claw-mcp.git"
    },
    "homepage": "https://1claw.xyz",
    "license": "MIT",
    "dependencies": {
        "@hono/node-server": "^1.19.10",
        "express-rate-limit": "^8.2.2",
        "fastmcp": "^3.33.0",
        "glob": "^11.1.0",
        "hono": "^4.12.4",
        "koa": "^3.1.2",
        "undici": "^7.24.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/node": "^20.19.33",
        "typescript": "^5.5.0",
        "vitest": "^2.1.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
